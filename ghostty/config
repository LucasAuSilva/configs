
# Shaders
custom-shader = ~/.config/ghostty/shaders/cursor_smear.glsl

# Font configs
font-family = JetBrains Mono
font-size = 12

# Background configs
background-opacity= 0.7
background-blur = true

# Keybinds
## Create new splits with vim keys
keybind = cmd+shift+n>h=new_split:left
keybind = cmd+shift+n>l=new_split:right
keybind = cmd+shift+n>k=new_split:up
keybind = cmd+shift+n>j=new_split:down

## Navigate Ghostty splits; reserve Ctrl+h/j/k/l for Neovim windows
keybind = cmd+ctrl+h=goto_split:left
keybind = cmd+ctrl+l=goto_split:right
keybind = cmd+ctrl+j=goto_split:bottom
keybind = cmd+ctrl+k=goto_split:top

## Zoom the current split to full app size
keybind = cmd+shift+z=toggle_split_zoom

# Theme
theme = Catppuccin Macchiato

