
# Ignore Local Instaled VIM Extensions
**/plugged
./tmux/plugin
./nvim/plugin

# Local/conditional environment-specific config (e.g. corporate proxy)
fish/conf.d/proxy.fish

# Any machine-local fish config (e.g. corporate certificate workarounds)
*.local.fish

# Corporate/internal opencode skill (do not publish)
opencode/skills/podman-migration/

# Machine-local git identity (work email, etc.) — keep the .example only
.gitconfig.local
git-config/.gitconfig.local
