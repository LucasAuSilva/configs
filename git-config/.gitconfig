[user]
	name = LucasAuSilva
	email = silvaaugustolucas@gmail.com
[alias]
	s = !git status -s
	c = !git add --all && git commit -m
	l = !git log --pretty=format:'%C(blue)%h%C(red)%d %C(yellow)%s - %C(cyan)%cn, %C(green)%cr'
	cm = !git commit -m
	amend = !git add . && git commit --amend --no-edit
	po = !git push --set-upstream origin $(git rev-parse --abbrev-ref HEAD)
[push]
  followTags = true
[core]
  # editor = code
	autocrlf = input

[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential

# Work identity: automatically applied for repos under ~/codes/.
# The referenced file is machine-local and gitignored (see .gitconfig.local.example).
[includeIf "gitdir:~/codes/"]
    path = ~/.gitconfig.local


